# meeting-playbook environment variables
# Copy to .env and fill in actual values for local development.

# ─── PostgreSQL ────────────────────────────────────────────────
# Local Homebrew default; create the database once via:
#   createdb meeting_playbook
DATABASE_URL=postgresql://localhost:5432/meeting_playbook

# ─── Better Auth ───────────────────────────────────────────────
# Generate a fresh secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=<generate via openssl rand -base64 32>
# The public origin where the gateway is reachable. Used for OAuth callbacks.
BETTER_AUTH_URL=http://localhost:3001

# ─── Google OAuth (Web Client) ─────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI MUST be exactly: http://localhost:3001/api/auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=<from GCP console>
GOOGLE_OAUTH_CLIENT_SECRET=<from GCP console>

# ─── Vertex AI (placeholders — used from Slice 5 onward) ───────
# Service account JSON path for application default credentials
GOOGLE_APPLICATION_CREDENTIALS=<path to service account JSON, optional for Slice 1>
VERTEX_AI_PROJECT=<GCP project id, optional for Slice 1>
VERTEX_AI_LOCATION=us-central1

# ─── Backend service URL (gateway forwards /api/* here) ────────
BACKEND_URL=http://localhost:8000

# ─── Logging ───────────────────────────────────────────────────
# Levels: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── Internal endpoints (Python backend ↔ Bun gateway) ─────────
# Used by the Python TokenStore to fetch / refresh Calendar OAuth tokens
# from the Better Auth account row through the gateway. The secret MUST be
# kept off-host; rotate by changing the value and restarting both services.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_INTERNAL_AUTH_SECRET=<generate via python3 -c "import secrets; print(secrets.token_urlsafe(32))">
BACKEND_INTERNAL_AUTH_URL=http://localhost:3001

# ─── Slice 6 — audio capture + ASR ────────────────────────────────
# Where session WAV files are written. User-data location, NOT inside the
# repo (recordings are private; surviving git-clean is right). The dir is
# created on demand by the capture service.
RECORDINGS_DIR=~/MeetingPlaybook/recordings

# faster-whisper config. The model is downloaded from HuggingFace Hub on
# first transcription (~1.5GB for large-v3-turbo). To run faster on CPU
# during dev: set WHISPER_MODEL_SIZE=small.
# ─── Slice 8 — Tactical advisor (Vertex Gemini Flash) ────────────
# Optional override for the in-meeting advisor model id. Default works on
# the same GCP project + service account already used for slice-5 playbook
# generation (which uses Pro). Update when a newer Flash variant ships.
# VERTEX_FLASH_MODEL_ID=gemini-2.0-flash-001

# ─── Slice 10 — Post-meeting summary (Vertex Gemini 2.5 Pro) ─────
# Optional override for the post-meeting summarizer model id. Default
# `gemini-2.5-pro` is the highest-quality SKU on Vertex in us-central1.
# Same naming rule as VERTEX_FLASH_MODEL_ID — must be a Vertex AI publisher
# model id, not a Gemini API name.
# VERTEX_PRO_MODEL_ID=gemini-2.5-pro

WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# ─── Slice 7 — dual-stream device overrides (both optional) ──────
# Auto-detection finds BlackHole 2ch by name and uses the system default
# microphone. Set these only if (a) you have multiple BlackHole versions
# installed (e.g. 2ch + 16ch) or (b) you want a non-default mic device.
# The values must match the device name reported by sounddevice.query_devices().
# BLACKHOLE_DEVICE_NAME=BlackHole 16ch
# MIC_DEVICE_NAME=My Specific Microphone

# ─── Slice 11 — recording retention ──────────────────────────────
# Days to keep wav recordings before the cleanup background job unlinks
# them and stamps `recording.deleted_at` (the row is preserved). `0` is
# valid: cleanup deletes everything older than `now()`. Default is 30
# (per ADR-0028 / slice-11 design Decision 5+6).
# RECORDING_RETENTION_DAYS=30

# ─── Slice 12 — Single-channel speaker attribution ──────────────
# HuggingFace access token for downloading the pyannote/speaker-diarization-3.1
# pretrained model (slice 12 / ADR-0029). Required only for Single-channel mode
# (面對面模式) with the pyannote provider. Without it, single-channel meetings
# fall back to the AppleSpeechProvider (macOS Speech Framework).
# PYANNOTE_AUTH_TOKEN=

# Rollback / kill switch for the speaker hybrid pipeline. When false, the
# session orchestrator forces DualChannelStrategy and rejects single-channel
# recording configurations as InvalidSpeakerConfiguration. Default true.
# SPEAKER_HYBRID_ENABLED=true